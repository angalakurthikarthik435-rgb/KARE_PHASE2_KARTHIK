public class Main {

    static class Node {
        int data;
        Node next;

        Node(int data) {
            this.data = data;
            this.next = null;
        }
    }

    static Node head = null;

    static void insert(int data) {
        Node newNode = new Node(data);

        if (head == null) {
            head = newNode;
            newNode.next = head;
        } else {
            Node temp = head;

            while (temp.next != head) {
                temp = temp.next;
            }

            temp.next = newNode;
            newNode.next = head;
        }
    }

    static int sum() {
        if (head == null) {
            return 0;
        }

        int total = 0;
        Node temp = head;

        do {
            total = total + temp.data;
            temp = temp.next;
        } while (temp != head);

        return total;
    }

    public static void main(String[] args) {

        insert(10);
        insert(20);
        insert(30);
        insert(40);

        System.out.println("Sum = " + sum());
    }
}

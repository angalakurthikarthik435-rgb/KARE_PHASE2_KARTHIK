//i/p->1 2 3
//o/p-> CSE EEE ECE
import java.util.*;
class Main{
    public static void main(String args[]){
      Scanner sc = new Scanner(System.in);
      int n = sc.nextInt();
      switch(n)
      {
          case 1:
          System.out.print("CSE");
          break;
          case 2:
          System.out.print("EEE");
          break;
          case 3:
          System.out.print("ECE");
          break;
          case 4:
          System.out.print("INVALID");
      }
    }
}
